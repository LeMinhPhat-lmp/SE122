{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },
  "Aers": {
    "Auth": {
      "RegistrationKeys": []
    },
    "Redis": {
      "ConnectionString": "localhost:6379",
      "KeyPrefix": "aers:"
    },
    "RegistrationLimits": {
      "MaxNameLength": 200,
      "MaxCapabilities": 50,
      "MaxSchemaBytes": 65536,
      "MaxBodyBytes": 1048576
    },
    "Policy": {
      "Heartbeat": {
        "IntervalSeconds": 15,
        "OfflineThresholdSeconds": 45
      },
      "DomainPolicy": {
        "Mode": "DenyByDefault",
        "CrossDomainRules": []
      }
    }
  }
}
